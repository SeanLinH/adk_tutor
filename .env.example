# 地端模型 OpenAI-compatible 端點設定
# 注意：OPENAI_API_BASE 必須包含 /v1 後綴
OPENAI_API_BASE=http://localhost:5052/v1
OPENAI_API_KEY=test123

# LiteLLM 模型字串。第一個 openai/ 是路由前綴（告訴 LiteLLM 走 OpenAI-compatible
# 協定），會被剝掉；剩下的 openai/gpt-oss-120b 才是真正送給端點的模型 ID。
# 端點上的模型 ID 由 GET /v1/models 確認。
ADK_MODEL_NAME=openai/openai/gpt-oss-120b
