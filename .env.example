# =============================================================
#  ADK 教學專案設定
#  複製這個檔案為 .env，填入你的金鑰即可。
# =============================================================

# --- 必填：Gemini API 金鑰 -----------------------------------
# 到 https://aistudio.google.com/apikey 免費申請。
# 若你的 shell 已經 export GEMINI_API_KEY，這裡可以留空，程式會自動抓。
GOOGLE_API_KEY=your_google_api_key_here

# --- 選填：模型 ----------------------------------------------
# 不填就用 shared/config.py 的 DEFAULT_MODEL（gemini-2.5-flash）。
# 注意 Gemini 模型會下架：gemini-2.0-flash 已在 2026 年停用，
# ADK_MODEL=gemini-3.5-flash

# --- 選填：改用非 Gemini 模型（Day 03 / Day 18 才需要）--------
# 把 ADK_PROVIDER 設成 litellm，就會走 LiteLLM 接本地或第三方模型。
# ADK_PROVIDER=litellm
# OPENAI_API_BASE=http://localhost:5052/v1     # 必須含 /v1 後綴
# OPENAI_API_KEY=test123
# 第一個 openai/ 是 LiteLLM 的路由前綴（會被剝掉），
# 剩下的 openai/gpt-oss-120b 才是端點上真正的模型 ID（用 GET /v1/models 確認）。
# ADK_MODEL=openai/openai/gpt-oss-120b

# --- 選填：Day 08 / 28 / 29 / 30 的 Google Cloud 相關 ---------
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=us-central1

